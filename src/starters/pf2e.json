{
	"name": "Starter PF2e",
	"columns": 12,
	"functions": [
		"# Proficiency is the whole of the arithmetic: untrained adds nothing, and",
		"# every trained rank adds level plus two per rank.",
		"level = passport.level",
		"prof(rank) = if(rank > 0, level + 2 * rank, 0)",
		"# The class's key attribute. Change this one line per character.",
		"key = attributes.STR",
		"# Spell slots follow the full-caster table: a rank opens at level 2R - 1 with",
		"# two slots and grows to three at level 2R, and rank 10 has one from level 19.",
		"# A bounded caster changes the slot rows, one line each.",
		"# The conditions all target armor class, so the stacking rule shows on one",
		"# number. A valued condition reads its own Value column, so Frightened 2 is",
		"# -2. Frightened really reaches every check and DC; a definition has one",
		"# target, so a fuller Frightened is one more definition per target."
	],
	"triggers": [
