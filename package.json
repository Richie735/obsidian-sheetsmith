{
	"name": "obsidian-sheetsmith",
	"version": "0.1.0",
	"description": "Design and use character sheets for any tabletop RPG in Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings 0",
		"test": "vitest run",
		"test:watch": "vitest",
		"harness": "node harness/build.mjs",
		"harness:watch": "node harness/build.mjs --watch",
		"harness:calibrate": "node harness/calibrate.mjs",
		"harness:shot": "node harness/shot.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"ttrpg",
		"rpg",
		"character-sheet",
		"tabletop"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"happy-dom": "^20.11.2",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10"
	}
}
