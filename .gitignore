# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Marker for the Hot Reload plugin during local development
.hotreload

# Test output
coverage

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Harness build output
harness/dist

# Obsidian's own CSS, extracted locally by `npm run harness:calibrate`.
# Never committed: it is not ours to redistribute.
harness/obsidian.generated.css
harness/shots

# Per-machine Claude Code state, not project configuration
.claude/settings.local.json
